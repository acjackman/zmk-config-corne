#!/usr/bin/env bash
#MISE description="Download firmware artifacts from the latest GitHub Actions build"
set -euo pipefail

branch=$(git branch --show-current)
run_id=$(gh run list --branch "$branch" --limit 1 --json databaseId --jq '.[0].databaseId')
if [ -z "$run_id" ]; then
  echo "No runs found for branch $branch" >&2
  exit 1
fi

# Wait for the run to complete if it's still in progress
status=$(gh run view "$run_id" --json status --jq '.status')
if [ "$status" != "completed" ]; then
  echo "Run $run_id is $status, waiting for it to finish..."
  gh run watch "$run_id"
fi

commit_sha=$(gh run view "$run_id" --json headSha --jq '.headSha' | head -c 7)
commit_date=$(gh run view "$run_id" --json createdAt --jq '.createdAt')
datestamp=$(echo "$commit_date" | sed 's/:[^:]*$//; s/:/-/g')

output_dir=".tmp/${datestamp}_${commit_sha}"
mkdir -p "$output_dir"
gh run download "$run_id" --dir "$output_dir"

# Flatten artifact subdirectories so .uf2 files live directly in output_dir
find "$output_dir" -mindepth 2 -type f -exec mv -f {} "$output_dir" \;
find "$output_dir" -mindepth 1 -type d -empty -delete

echo "$output_dir"
